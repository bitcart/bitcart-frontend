{
  "name": "@bitcart/ui-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "build:main": "vite build",
    "build:styles": "unocss",
    "dev:main": "vite dev --host",
    "dev:styles": "unocss --watch",
    "generate:graphviz": "depcruise src --output-type dot | ../../scripts/generate-graphviz.ts graphviz.svg",
    "i18n:extract-locales": "lingui extract --clean",
    "lint": "oxlint . --fix",
    "lint:check": "oxlint .",
    "postinstall": "fumadocs-mdx",
    "preview": "vite preview --host",
    "typecheck": "fumadocs-mdx && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bitcart/core": "workspace:*",
    "@bitcart/hooks": "workspace:*",
    "@bitcart/tanstack-start-kit": "workspace:*",
    "@bitcart/ui-kit": "workspace:*",
    "@fontsource-variable/geist-mono": "catalog:dependencies",
    "@fontsource-variable/inter": "catalog:dependencies",
    "@fumadocs/base-ui": "catalog:dependencies",
    "@lingui/core": "catalog:dependencies",
    "@lingui/react": "catalog:dependencies",
    "@phosphor-icons/react": "catalog:dependencies",
    "@t3-oss/env-core": "catalog:dependencies",
    "@tanstack/react-router": "catalog:dependencies",
    "@tanstack/react-router-devtools": "catalog:dependencies",
    "@tanstack/react-start": "catalog:dependencies",
    "@tanstack/start-static-server-functions": "catalog:dependencies",
    "fumadocs-core": "catalog:dependencies",
    "fumadocs-mdx": "catalog:dependencies",
    "fumadocs-ui": "catalog:dependencies",
    "lucide-react": "catalog:dependencies",
    "react": "catalog:dependencies",
    "react-dom": "catalog:dependencies",
    "remeda": "catalog:dependencies",
    "use-sync-external-store": "catalog:dependencies",
    "vite": "catalog:devDependencies"
  },
  "devDependencies": {
    "@bitcart/configs": "workspace:*",
    "@bitcart/unocss-kit": "workspace:*",
    "@fumadocs/story": "catalog:devDependencies",
    "@lingui/cli": "catalog:devDependencies",
    "@lingui/conf": "catalog:devDependencies",
    "@lingui/native-tools": "catalog:devDependencies",
    "@lingui/vite-plugin": "catalog:devDependencies",
    "@stylistic/eslint-plugin": "catalog:devDependencies",
    "@tailwindcss/vite": "catalog:devDependencies",
    "@types/mdx": "catalog:devDependencies",
    "@types/node": "catalog:devDependencies",
    "@types/react": "catalog:devDependencies",
    "@types/react-dom": "catalog:devDependencies",
    "@unocss/cli": "catalog:devDependencies",
    "@vitejs/plugin-react": "catalog:devDependencies",
    "dependency-cruiser": "catalog:devDependencies",
    "eslint-plugin-better-tailwindcss": "catalog:devDependencies",
    "eslint-plugin-react-hooks": "catalog:devDependencies",
    "nitro": "catalog:devDependencies",
    "oxc-transform-react": "catalog:devDependencies",
    "oxlint": "catalog:devDependencies",
    "srvx": "catalog:devDependencies",
    "tailwindcss": "catalog:devDependencies",
    "typescript": "catalog:devDependencies",
    "unocss": "catalog:devDependencies"
  }
}

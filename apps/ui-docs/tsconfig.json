{
  "extends": [
    "@bitcart/configs/by-package-type/app-ts",
    "@bitcart/configs/by-view-layer/react-ts",
    "@bitcart/configs/by-target-platform/browser-ts"
  ],

  "mdx": {
    "checkMdx": true
  },

  "compilerOptions": {
    "allowJs": true,
    "types": ["node", "vite/client"],

    "paths": {
      "@/*": ["./src/*"],
      "collections/*": ["./.source/*"]
    }
  },

  "exclude": ["dist", ".output", "node_modules"],
  "include": ["src", "content", "*.ts", "**/*.mdx"]
}

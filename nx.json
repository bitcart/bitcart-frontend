{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "tui": {
    "autoExit": true
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "buildInputs": ["default", "!{projectRoot}/e2e/**", "!{projectRoot}/playwright.config.ts"],
    "sharedGlobals": ["{workspaceRoot}/.env", { "env": "BITCART_ENV" }],
    "oxlintInputs": ["default", "{workspaceRoot}/oxlint.config.ts"],
    "packageBuildInputs": ["{projectRoot}/**/*"],

    "appCatalogs": [
      {
        "runtime": "cat apps/*/src/common/i18n/_generated/locales/*.po apps/*/src/templates/*/locales/*.po templates/*/src/common/i18n/_generated/locales/*.po 2>/dev/null | cksum"
      }
    ],

    "packageCatalogs": [
      { "runtime": "cat packages/*/src/i18n/_generated/locales/*.po 2>/dev/null | cksum" }
    ]
  },
  "targetDefaults": {
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "cache": true
    },

    "lint:check": {
      "dependsOn": ["^build", "^lint:check"],
      "inputs": ["oxlintInputs", "^default"],
      "cache": true
    },

    "depcruise:deps": {
      "dependsOn": ["build"],
      "inputs": ["default", "^default"],
      "cache": true
    },

    "lint": {
      "dependsOn": ["^build", "^lint"],
      "inputs": ["oxlintInputs", "^default"],
      "cache": true
    },

    "dev": {
      "cache": false,
      "continuous": true
    },

    "build": [
      {
        "dependsOn": ["^build"],
        "outputs": ["{projectRoot}/dist"],
        "cache": true
      },

      {
        "filter": { "projects": ["packages/*"] },
        "inputs": ["packageBuildInputs", "^packageBuildInputs"]
      }
    ],

    "build:*": [
      {
        "filter": { "projects": ["packages/*"] },
        "inputs": ["packageBuildInputs", "^packageBuildInputs"]
      }
    ],

    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "continuous": true
    },

    "i18n:extract-locales": {
      "dependsOn": ["^build"],
      "inputs": ["buildInputs", "^default", "appCatalogs", "packageCatalogs"],
      "outputs": ["{projectRoot}/src/common/i18n/_generated"],
      "cache": true
    },

    "e2e": {
      "dependsOn": ["build"],
      "cache": false
    }
  },
  "defaultBase": "master",
  "analytics": false
}

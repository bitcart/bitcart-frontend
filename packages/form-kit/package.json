{
  "name": "@bitcart/form-kit",
  "version": "1.0.0",
  "description": "Form development kit for applications and websites under the Bitcart umbrella",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "types": "./dist/hooks/index.d.ts"
    },
    "./i18n": {
      "import": "./dist/i18n/index.js",
      "types": "./dist/i18n/index.d.ts"
    },
    "./validation": {
      "import": "./dist/validation/index.js",
      "types": "./dist/validation/index.d.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:check": "oxlint .",
    "lint": "oxlint . --fix",
    "generate:graphviz": "depcruise src --output-type dot | ../../scripts/graphviz-postprocess.ts | dot -T svg -o graphviz.svg",
    "depcruise:deps": "depcruise dist --output-type err-long",
    "i18n:extract-locales": "lingui extract --clean",
    "build": "tsdown"
  },
  "dependencies": {
    "@bitcart/core": "workspace:*",
    "@bitcart/ui-kit": "workspace:*",
    "@lingui/core": "catalog:dependencies",
    "@tanstack/react-form": "catalog:dependencies",
    "react": "catalog:dependencies",
    "remeda": "catalog:dependencies"
  },
  "devDependencies": {
    "@bitcart/configs": "workspace:*",
    "@lingui/cli": "catalog:devDependencies",
    "@lingui/conf": "catalog:devDependencies",
    "@lingui/react": "catalog:dependencies",
    "@stylistic/eslint-plugin": "catalog:devDependencies",
    "@testing-library/dom": "catalog:devDependencies",
    "@testing-library/react": "catalog:devDependencies",
    "@types/node": "catalog:devDependencies",
    "@types/react": "catalog:devDependencies",
    "@vitejs/plugin-react": "catalog:devDependencies",
    "dependency-cruiser": "catalog:devDependencies",
    "eslint-plugin-react-hooks": "catalog:devDependencies",
    "jsdom": "catalog:devDependencies",
    "oxc-transform-react": "catalog:devDependencies",
    "oxlint": "catalog:devDependencies",
    "oxlint-tsgolint": "catalog:devDependencies",
    "tsdown": "catalog:devDependencies",
    "typescript": "catalog:devDependencies",
    "vitest": "catalog:devDependencies",
    "zod": "catalog:dependencies"
  }
}

{
  "name": "@bitcart/ui-kit",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "i18n:extract-locales": {
      "outputs": ["{projectRoot}/src/i18n/_generated"]
    },

    "build:styles": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/src/styles/uno.generated.css"],
      "cache": true
    },

    "build:main": {
      "dependsOn": ["build:styles", "i18n:extract-locales", "^build"],
      "inputs": ["packageBuildInputs", "^packageBuildInputs", "packageCatalogs"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },

    "build": {
      "dependsOn": ["build:main"],
      "outputs": []
    },

    "lint:check": {
      "dependsOn": ["build:styles", "^build", "^lint:check"]
    },

    "lint": {
      "dependsOn": ["build:styles", "^build", "^lint"]
    }
  }
}

{
  "name": "@bitcart/ui-kit",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "generate:coin-icons": {
      "executor": "nx:run-commands",

      "options": {
        "commands": ["tsx ./scripts/generate-coin-icons.ts", "oxfmt src/coin-icons/generated"],

        "parallel": false,
        "cwd": "packages/ui-kit"
      },

      "inputs": [
        "{projectRoot}/scripts/generate-coin-icons.ts",
        { "externalDependencies": ["@web3icons/common", "@web3icons/react", "oxfmt", "tsx"] }
      ],

      "outputs": ["{projectRoot}/src/coin-icons/generated"],
      "cache": true
    },

    "i18n:extract-locales": {
      "outputs": ["{projectRoot}/src/i18n/_generated"]
    },

    "build:styles": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/src/styles/uno.generated.css"],
      "cache": true
    },

    "build:main": {
      "dependsOn": ["generate:coin-icons", "build:styles", "i18n:extract-locales", "^build"],
      "inputs": ["packageBuildInputs", "^packageBuildInputs", "packageCatalogs"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },

    "build": {
      "dependsOn": ["build:main"],
      "outputs": []
    },

    "lint:check": {
      "dependsOn": ["build:styles", "^build", "^lint:check"]
    },

    "lint": {
      "dependsOn": ["build:styles", "^build", "^lint"]
    }
  }
}

{
  "name": "@bitcart/ui-kit",
  "version": "1.1.0",
  "description": "UI development kit for applications and websites under the Bitcart umbrella",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./fonts": {
      "import": "./dist/fonts.js",
      "types": "./dist/fonts.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "types": "./dist/hooks/index.d.ts"
    },
    "./i18n": {
      "import": "./dist/i18n/index.js",
      "types": "./dist/i18n/index.d.ts"
    },
    "./icons": {
      "import": "./dist/icons.js",
      "types": "./dist/icons.d.ts"
    },
    "./providers": {
      "import": "./dist/providers/index.js",
      "types": "./dist/providers/index.d.ts"
    },
    "./styles": {
      "import": "./dist/styles/index.js",
      "types": "./dist/styles/index.d.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    }
  },
  "scripts": {
    "add:components": "pnpm shadcn-ui add -p ./src/components/tmp",
    "build:main": "tsdown",
    "build:styles": "unocss",
    "depcruise:deps": "depcruise dist --output-type err-long",
    "generate:graphviz": "depcruise src --output-type dot | ../../scripts/generate-graphviz.ts graphviz.svg",
    "i18n:extract-locales": "lingui extract --clean",
    "lint": "oxlint . --fix",
    "lint:check": "oxlint .",
    "shadcn-ui": "pnpm dlx shadcn@latest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "catalog:dependencies",
    "@bitcart/core": "workspace:*",
    "@bitcart/hooks": "workspace:*",
    "@daypicker/react": "catalog:dependencies",
    "@lingui/core": "catalog:dependencies",
    "@lingui/react": "catalog:dependencies",
    "@phosphor-icons/react": "catalog:dependencies",
    "@web3icons/react": "catalog:dependencies",
    "class-variance-authority": "catalog:dependencies",
    "lucide-react": "catalog:dependencies",
    "next-themes": "catalog:dependencies",
    "react": "catalog:dependencies",
    "remeda": "catalog:dependencies",
    "sonner": "catalog:dependencies",
    "tailwind-merge": "catalog:dependencies"
  },
  "devDependencies": {
    "@bitcart/configs": "workspace:*",
    "@bitcart/qa": "workspace:*",
    "@bitcart/unocss-kit": "workspace:*",
    "@lingui/cli": "catalog:devDependencies",
    "@lingui/conf": "catalog:devDependencies",
    "@stylistic/eslint-plugin": "catalog:devDependencies",
    "@testing-library/dom": "catalog:devDependencies",
    "@testing-library/react": "catalog:devDependencies",
    "@types/node": "catalog:devDependencies",
    "@types/react": "catalog:devDependencies",
    "@unocss/cli": "catalog:devDependencies",
    "@vitejs/plugin-react": "catalog:devDependencies",
    "@web3icons/common": "catalog:devDependencies",
    "dependency-cruiser": "catalog:devDependencies",
    "eslint-plugin-better-tailwindcss": "catalog:devDependencies",
    "eslint-plugin-react-hooks": "catalog:devDependencies",
    "jsdom": "catalog:devDependencies",
    "oxc-transform-react": "catalog:devDependencies",
    "oxlint": "catalog:devDependencies",
    "oxlint-tsgolint": "catalog:devDependencies",
    "tsdown": "catalog:devDependencies",
    "tsx": "catalog:devDependencies",
    "typescript": "catalog:devDependencies",
    "unocss": "catalog:devDependencies",
    "vite-plugin-svgr": "catalog:devDependencies",
    "vitest": "catalog:devDependencies"
  }
}

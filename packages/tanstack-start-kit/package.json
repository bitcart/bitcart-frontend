{
  "name": "@bitcart/tanstack-start-kit",
  "version": "1.0.0",
  "description": "Shared TanStack Start integration for Bitcart applications",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js"
    },
    "./fumadocs": {
      "types": "./dist/fumadocs/index.d.ts",
      "import": "./dist/fumadocs/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata/index.d.ts",
      "import": "./dist/metadata/index.js"
    },
    "./navigation": {
      "types": "./dist/navigation/index.d.ts",
      "import": "./dist/navigation/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "import": "./dist/telemetry/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "depcruise:deps": "depcruise dist --output-type err-long",
    "generate:dist-graphviz": "depcruise dist --output-type dot | dot -T svg -o dist-graphviz.svg",
    "generate:graphviz": "depcruise src --output-type dot | ../../scripts/generate-graphviz.ts graphviz.svg",
    "lint": "oxlint . --fix",
    "lint:check": "oxlint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.lib.json"
  },
  "dependencies": {
    "@bitcart/core": "workspace:*",
    "@bitcart/hooks": "workspace:*",
    "@lingui/core": "catalog:dependencies",
    "@lingui/react": "catalog:dependencies",
    "react": "catalog:dependencies"
  },
  "devDependencies": {
    "@bitcart/configs": "workspace:*",
    "@stylistic/eslint-plugin": "catalog:devDependencies",
    "@tanstack/react-router": "catalog:dependencies",
    "@types/node": "catalog:devDependencies",
    "@types/react": "catalog:devDependencies",
    "dependency-cruiser": "catalog:devDependencies",
    "eslint-plugin-react-hooks": "catalog:devDependencies",
    "fumadocs-core": "catalog:dependencies",
    "oxlint": "catalog:devDependencies",
    "oxlint-tsgolint": "catalog:devDependencies",
    "tsdown": "catalog:devDependencies",
    "typescript": "catalog:devDependencies",
    "vitest": "catalog:devDependencies"
  },
  "peerDependencies": {
    "@tanstack/react-router": "catalog:dependencies",
    "fumadocs-core": "catalog:dependencies"
  },
  "peerDependenciesMeta": {
    "fumadocs-core": {
      "optional": true
    }
  }
}

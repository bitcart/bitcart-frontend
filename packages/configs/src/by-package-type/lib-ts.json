{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../base/ts.json",

  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noEmit": false
  },

  "exclude": [
    "${configDir}/dist",
    "${configDir}/node_modules",
    "${configDir}/src/**/*.spec.ts",
    "${configDir}/src/**/*.spec.tsx"
  ]
}

{
  "name": "@bitcart/core",
  "version": "1.0.0",
  "description": "Foundational abstractions for packages, applications, and websites under the Bitcart umbrella.",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./i18n": {
      "import": "./dist/i18n/index.js",
      "types": "./dist/i18n/index.d.ts"
    },
    "./metadata": {
      "import": "./dist/metadata/index.js",
      "types": "./dist/metadata/index.d.ts"
    },
    "./navigation": {
      "import": "./dist/navigation/index.js",
      "types": "./dist/navigation/index.d.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    },
    "./validation": {
      "import": "./dist/validation/index.js",
      "types": "./dist/validation/index.d.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.lib.json",
    "lint:check": "oxlint .",
    "lint": "oxlint . --fix",
    "generate:graphviz": "depcruise src --output-type dot | ../../scripts/graphviz-postprocess.js | dot -T svg -o graphviz.svg",
    "generate:dist-graphviz": "depcruise dist --output-type dot | dot -T svg -o dist-graphviz.svg",
    "depcruise:deps": "depcruise dist --output-type err",
    "build": "tsdown"
  },
  "dependencies": {
    "@lingui/core": "catalog:dependencies",
    "remeda": "catalog:dependencies",
    "zod": "catalog:dependencies"
  },
  "devDependencies": {
    "@bitcart/configs": "workspace:*",
    "@stylistic/eslint-plugin": "catalog:devDependencies",
    "@testing-library/dom": "catalog:devDependencies",
    "@testing-library/jest-dom": "catalog:devDependencies",
    "@testing-library/user-event": "catalog:devDependencies",
    "@types/node": "catalog:devDependencies",
    "dependency-cruiser": "catalog:devDependencies",
    "jsdom": "catalog:devDependencies",
    "oxlint": "catalog:devDependencies",
    "oxlint-tsgolint": "catalog:devDependencies",
    "tsdown": "catalog:devDependencies",
    "typescript": "catalog:devDependencies",
    "vitest": "catalog:devDependencies"
  }
}

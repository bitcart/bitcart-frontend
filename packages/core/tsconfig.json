{
  "extends": [
    "@bitcart/configs/by-package-type/lib-ts",
    "@bitcart/configs/by-target-platform/browser-ts"
  ],

  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": ["node"],

    "paths": {
      "@/*": ["./src/*"]
    }
  },

  "exclude": ["dist", "node_modules"],
  "include": ["src", "*.config.ts", "*.setup.ts"]
}

{
  "name": "@bitcart/api-sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for the Bitcart Merchants API.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    "./auth": {
      "import": "./dist/auth.js",
      "types": "./dist/auth.d.ts"
    },
    "./config": {
      "import": "./dist/config.js",
      "types": "./dist/config.d.ts"
    },
    "./endpoints": {
      "import": "./dist/endpoints.js",
      "types": "./dist/endpoints.d.ts"
    },
    "./mocks": {
      "import": "./dist/mocks.js",
      "types": "./dist/mocks.d.ts"
    },
    "./schemas": {
      "import": "./dist/schemas.js",
      "types": "./dist/schemas.d.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "types": "./dist/utils.d.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.lib.json",
    "lint:check": "oxlint .",
    "lint": "oxlint . --fix",
    "generate:graphviz": "depcruise src --output-type dot | ../../scripts/graphviz-postprocess.js | dot -T svg -o graphviz.svg",
    "generate:dist-graphviz": "depcruise dist --output-type dot | dot -T svg -o dist-graphviz.svg",
    "depcruise:deps": "depcruise dist --output-type err-long",
    "build": "tsdown"
  },
  "dependencies": {
    "@bitcart/core": "workspace:*",
    "@tanstack/react-query": "catalog:dependencies",
    "react": "catalog:dependencies",
    "remeda": "catalog:dependencies",
    "zod": "catalog:dependencies"
  },
  "devDependencies": {
    "@bitcart/configs": "workspace:*",
    "@faker-js/faker": "catalog:devDependencies",
    "@stylistic/eslint-plugin": "catalog:devDependencies",
    "@types/node": "catalog:devDependencies",
    "@types/react": "catalog:devDependencies",
    "dependency-cruiser": "catalog:devDependencies",
    "msw": "catalog:devDependencies",
    "orval": "catalog:devDependencies",
    "oxlint": "catalog:devDependencies",
    "oxlint-tsgolint": "catalog:devDependencies",
    "tsdown": "catalog:devDependencies",
    "tsx": "catalog:devDependencies",
    "typescript": "catalog:devDependencies"
  },
  "peerDependencies": {
    "@faker-js/faker": "catalog:devDependencies",
    "msw": "catalog:devDependencies"
  },
  "peerDependenciesMeta": {
    "@faker-js/faker": {
      "optional": true
    },
    "msw": {
      "optional": true
    }
  }
}

{
  "preferred_line_length": 100,
  "format_on_save": "on",
  "read_only_files": ["**/routeTree.gen.ts", "packages/client-sdk/openapi.json"],

  "git_hosting_providers": [
    {
      "provider": "forgejo",
      "name": "Bitcart Forge",
      "base_url": "https://git.bitcart.ai"
    }
  ],

  "languages": {
    "JavaScript": {
      "formatter": { "language_server": { "name": "oxfmt" } },

      "code_actions_on_format": {
        "source.fixAll.oxc": true
      },

      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "!tailwindcss-language-server",
        "..."
      ]
    },

    "TypeScript": {
      "formatter": { "language_server": { "name": "oxfmt" } },

      "code_actions_on_format": {
        "source.fixAll.oxc": true
      },

      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "!tailwindcss-language-server",
        "..."
      ]
    },

    "TSX": {
      "formatter": { "language_server": { "name": "oxfmt" } },

      "code_actions_on_format": {
        "source.fixAll.oxc": true
      },

      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "!tailwindcss-language-server",
        "..."
      ]
    },

    "JSON": { "formatter": { "language_server": { "name": "oxfmt" } } },
    "JSONC": { "formatter": { "language_server": { "name": "oxfmt" } } },
    "YAML": { "formatter": { "language_server": { "name": "oxfmt" } } },
    "MDX": { "formatter": { "language_server": { "name": "oxfmt" } } },
    "Markdown": { "formatter": { "language_server": { "name": "oxfmt" } } },
    "TOML": { "formatter": { "language_server": { "name": "oxfmt" } } },
    "HTML": { "formatter": { "language_server": { "name": "oxfmt" } } },
    "CSS": { "formatter": { "language_server": { "name": "oxfmt" } } }
  }
}
